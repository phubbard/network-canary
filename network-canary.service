[Unit]
Description=Network Canary Monitor
# Start early at boot - we want to monitor network issues, not wait for network
After=local-fs.target

[Service]
Type=simple
User=pfh
WorkingDirectory=/home/pfh/code/canary
ExecStart=/home/pfh/code/canary/network_status.py
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
